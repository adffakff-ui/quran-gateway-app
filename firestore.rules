rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidTenant() {
      let data = request.resource.data;
      return data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.city is string
        && data.code is string;
    }

    match /tenants/{tenantId} {
      // Anyone using the application can read registered societies
      allow read: if true;

      // Only authenticated users (Owner/Admins) can create, update, or delete tenants
      allow create: if isAuthenticated() && isValidTenant() && request.resource.data.id == tenantId;
      allow update: if isAuthenticated() && isValidTenant();
      allow delete: if isAuthenticated();
    }

    match /users/{userId} {
      // Anyone authenticated can read user profiles, and users can create/update their own profile
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
